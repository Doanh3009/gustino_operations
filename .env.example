VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only automatic day close. Never prefix these secrets with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters

# Server-only Zalo GMF secrets. Never prefix these with VITE_.
ZALO_OA_ACCESS_TOKEN=your-short-lived-oa-access-token
ZALO_GMF_GROUP_ID=your-gmf-group-id

# Server-only n8n report queue. Never prefix these with VITE_.
N8N_REPORT_WEBHOOK_URL=https://your-n8n.example/webhook/gustino-report-ready
N8N_REPORT_WEBHOOK_TOKEN=replace-with-a-long-random-header-secret
N8N_REPORT_ENABLED=false
